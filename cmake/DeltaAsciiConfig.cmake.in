@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(absl CONFIG)
find_dependency(ada CONFIG)
if (@D2_UNICODE_MODE@)
    find_dependency(uni-algo CONFIG)
endif()
if (@D2_CONFIG_CURL@)
    find_dependency(CURL)
endif()
if (@D2_CONFIG_PIPEWIRE@)
    find_dependency(PkgConfig)
    pkg_check_modules(PIPEWIRE REQUIRED IMPORTED_TARGET libpipewire-0.3)
endif()
if (@D2_CONFIG_PNG@)
    find_dependency(PNG)
endif()
if (@D2_CONFIG_INFERENCE@)
    find_dependency(nlohmann_json 3.11 CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/DeltaAsciiTargets.cmake")
check_required_components(DeltaAscii)
